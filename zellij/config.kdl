//
// Zellij config tuned for Neovim + Oh My Pi
//
// Philosophy:
//   Ctrl-a = talk to Zellij
//   everything else = talk to the application
//

default_mode "locked"

// Default layout: custom Rose Pine compact bar powered by zjstatus
default_layout "default"

// Modern Zellij title-only pane frames
pane_frame_style "titles"

// Avoid mouse scrolling unexpectedly changing Zellij input modes
scroll_mode_sync false

// Editor for viewing scrollback
scrollback_editor "nvim"

// Copy selection to system clipboard on mouse release (matches Ghostty copy-on-select)
copy_on_select true

plugins {
    zellij-forgot location="file:~/.config/zellij/plugins/zellij_forgot.wasm"
}

keybinds clear-defaults=true {
    // ------------------------------------------------------------
    // LOCKED
    // Everything goes through to Neovim/OMP except Ctrl-a
    // ------------------------------------------------------------
    locked {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    // ------------------------------------------------------------
    // TMUX MODE: Ctrl-a
    // Emulates tmux with single-stroke commands returning to Locked
    // ------------------------------------------------------------
    tmux {
        // Literal prefix & toggle
        bind "a" { WriteChars "\u{0001}"; SwitchToMode "Locked"; }
        bind "Ctrl a" "Tab" { ToggleTab; SwitchToMode "Locked"; }
        bind "Esc" "q" { SwitchToMode "Locked"; }

        // Tabs (Windows): Ctrl-a + 1..9, c, n, p, &, ,
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }

        bind "c" { NewTab; SwitchToMode "Locked"; }
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "&" "X" { CloseTab; SwitchToMode "Locked"; }
        bind "," {
            SwitchToMode "RenameTab";
            TabNameInput 0;
        }

        // Panes: splits, navigation, zoom, kill
        bind "h" "Left"  { MoveFocus "Left";  SwitchToMode "Locked"; }
        bind "j" "Down"  { MoveFocus "Down";  SwitchToMode "Locked"; }
        bind "k" "Up"    { MoveFocus "Up";    SwitchToMode "Locked"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }

        bind "\"" "-"     { NewPane "Down";  SwitchToMode "Locked"; }
        bind "%" "|" "\\" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "z"         { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "x"         { CloseFocus; SwitchToMode "Locked"; }
        bind "o"         { FocusNextPane; SwitchToMode "Locked"; }
        bind ";"         { FocusLastPane; SwitchToMode "Locked"; }
        bind "{"         { MovePaneBackwards; SwitchToMode "Locked"; }
        bind "}"         { MovePane; SwitchToMode "Locked"; }
        bind "!"         { BreakPane; SwitchToMode "Locked"; }
        bind "Space"     { NextSwapLayout; SwitchToMode "Locked"; }

        // Floating & File Explorer
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "f" {
            LaunchOrFocusPlugin "zellij:strider" {
                floating true
            }
            SwitchToMode "Locked"
        }

        // Scrollback / Copy mode (tmux '[')
        bind "[" { SwitchToMode "Scroll"; }

        // Session management (tmux 'd', 's')
        bind "d" { Detach; }
        bind "s" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Locked"
        }

        // Advanced Zellij sub-modes
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "P" { SwitchToMode "Pane"; }

        // Keybindings cheat sheet
        bind "?" {
            LaunchOrFocusPlugin "zellij-forgot" {
                floating true
            }
            SwitchToMode "Locked"
        }
    }

    // Normal mode as backup alias
    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    // ------------------------------------------------------------
    // PANES: Ctrl-a p
    // ------------------------------------------------------------
    pane {
        bind "h" "Left"  { MoveFocus "Left";  SwitchToMode "Locked"; }
        bind "j" "Down"  { MoveFocus "Down";  SwitchToMode "Locked"; }
        bind "k" "Up"    { MoveFocus "Up";    SwitchToMode "Locked"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }

        bind ";"   { FocusLastPane; SwitchToMode "Locked"; }
        bind "Tab" { SwitchFocus;   SwitchToMode "Locked"; }

        bind "n" { NewPane;           SwitchToMode "Locked"; }
        bind "d" { NewPane "Down";    SwitchToMode "Locked"; }
        bind "r" { NewPane "Right";   SwitchToMode "Locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Locked"; }

        bind "x" { CloseFocus;            SwitchToMode "Locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes;   SwitchToMode "Locked"; }

        bind "c" {
            SwitchToMode "RenamePane";
            PaneNameInput 0;
        }
    }

    // ------------------------------------------------------------
    // TABS: Ctrl-a t
    // ------------------------------------------------------------
    tab {
        bind "h" "Left" "Up" "k" {
            GoToPreviousTab;
            SwitchToMode "Locked";
        }

        bind "l" "Right" "Down" "j" {
            GoToNextTab;
            SwitchToMode "Locked";
        }
        bind "n" { NewTab;   SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }

        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }

        bind "Tab" { ToggleTab; SwitchToMode "Locked"; }

        bind "c" {
            SwitchToMode "RenameTab";
            TabNameInput 0;
        }
    }

    // ------------------------------------------------------------
    // RESIZE: Ctrl-a r
    // ------------------------------------------------------------
    resize {
        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }

        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }

        bind "=" "+" { Resize "Increase"; }
        bind "-"     { Resize "Decrease"; }

        bind "Enter" "Esc" "q" { SwitchToMode "Locked"; }
    }

    // ------------------------------------------------------------
    // MOVE PANES: Ctrl-a m
    // ------------------------------------------------------------
    move {
        bind "h" "Left"  { MovePane "Left"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }

        bind "n" "Tab" { MovePane; }
        bind "p"       { MovePaneBackwards; }

        bind "Enter" "Esc" "q" { SwitchToMode "Locked"; }
    }

    // ------------------------------------------------------------
    // SCROLLBACK: Ctrl-a s
    // ------------------------------------------------------------
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up"   { ScrollUp; }

        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp"   { PageScrollUp; }

        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }

        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }

        // Open scrollback in $EDITOR (eg. Neovim)
        bind "e" {
            EditScrollback;
            SwitchToMode "Locked";
        }

        // Search scrollback
        bind "/" {
            SwitchToMode "EnterSearch";
            SearchInput 0;
        }

        bind "Ctrl c" "Esc" "q" {
            ScrollToBottom;
            SwitchToMode "Locked";
        }
    }

    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up"   { ScrollUp; }

        bind "n" { Search "down"; }
        bind "N" { Search "up"; }

        bind "Ctrl c" "Esc" "q" {
            ScrollToBottom;
            SwitchToMode "Locked";
        }
    }

    entersearch {
        bind "Esc"    { SwitchToMode "Scroll"; }
        bind "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Enter"  { SwitchToMode "Search"; }
    }

    // ------------------------------------------------------------
    // SESSION: Ctrl-a o
    // ------------------------------------------------------------
    session {
        // detach, keeping everything alive
        bind "d" { Detach; }

        // session manager
        bind "w" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }

        // Zellij configuration UI
        bind "c" {
            LaunchOrFocusPlugin "zellij:configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
    }

    renametab {
        bind "Enter" "Ctrl c" {
            SwitchToMode "Locked";
        }

        bind "Esc" {
            UndoRenameTab;
            SwitchToMode "Locked";
        }
    }

    renamepane {
        bind "Enter" "Ctrl c" {
            SwitchToMode "Locked";
        }

        bind "Esc" {
            UndoRenamePane;
            SwitchToMode "Locked";
        }
    }

    // ------------------------------------------------------------
    // Ctrl-a = leave Zellij control mode
    // ------------------------------------------------------------
    shared_except "locked" "tmux" "renametab" "renamepane" {
        bind "Ctrl a" { SwitchToMode "Locked"; }
        bind "?" {
            LaunchOrFocusPlugin "zellij-forgot" {
                floating true
            };
            SwitchToMode "Locked";
        }
    }
    shared_except "renamepane" "renametab" "entersearch" "locked" {
        bind "Esc" { SwitchToMode "Locked"; }
    }

    shared_except "pane" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "p" { SwitchToMode "Pane"; }
    }

    shared_except "resize" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "r" { SwitchToMode "Resize"; }
    }

    shared_except "scroll" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "s" { SwitchToMode "Scroll"; }
    }

    shared_except "session" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "o" { SwitchToMode "Session"; }
    }

    shared_except "tab" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "t" { SwitchToMode "Tab"; }
    }

    shared_except "move" "locked" "tmux" "renametab" "renamepane" "entersearch" {
        bind "m" { SwitchToMode "Move"; }
    }

    // ------------------------------------------------------------
    // Direct 1-stroke pane navigation (Alt/Option + hjkl) & tab jump (Alt + 1..9)
    // ------------------------------------------------------------
    shared_except "renametab" "renamepane" {
        bind "Alt h" "Alt Left"  { MoveFocus "Left"; }
        bind "Alt j" "Alt Down"  { MoveFocus "Down"; }
        bind "Alt k" "Alt Up"    { MoveFocus "Up"; }
        bind "Alt l" "Alt Right" { MoveFocus "Right"; }

        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}
